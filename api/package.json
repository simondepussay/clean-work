    "jose": "^5.10.0",
    "pdf-lib": "^1.17.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "7.0",
    "vitest": "^5.0.5"
  }
}
