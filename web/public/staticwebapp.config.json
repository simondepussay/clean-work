{
  "platform": {
    "apiRuntime": "node:22"
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/*.css",
      "/*.html",
      "/*.js",
      "/*.json",
      "/api/*",
      "/assets/*"
    ]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  }
}
